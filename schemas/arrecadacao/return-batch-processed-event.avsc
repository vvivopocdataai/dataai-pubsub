{
  "type": "record",
  "name": "ReturnBatchProcessedEvent",
  "namespace": "com.vivo.dataai.arrecadacao",
  "doc": "Sem entidade TM Forum equivalente. Espelha exatamente a tabela arrecadacao.lote_retorno (mesmos nomes e tipos de coluna), para uso via broker sem disrupcao de consumidores diretos da base. Contrato base v1.0.0.",
  "fields": [
    {"name": "eventId", "type": "string"},
    {"name": "eventType", "type": "string", "default": "ReturnBatchProcessedEvent"},
    {"name": "eventTime", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "domain", "type": "string", "default": "Commercial"},
    {"name": "event", "type": {
      "type": "record",
      "name": "ReturnBatch",
      "fields": [
        {"name": "id_lote", "type": "string", "doc": "PK."},
        {"name": "cd_banco", "type": "string"},
        {"name": "nm_arquivo", "type": "string"},
        {"name": "dt_prevista", "type": {"type": "int", "logicalType": "date"}},
        {"name": "dt_recebida", "type": ["null", {"type": "int", "logicalType": "date"}], "default": null},
        {"name": "qt_registros", "type": "int"},
        {"name": "st_lote", "type": "string", "doc": "Valores permitidos pela constraint CHECK da origem: RECEBIDO, PROCESSADO, ERRO_PROCESSAMENTO."},
        {"name": "dt_atualizacao", "type": {"type": "long", "logicalType": "timestamp-millis"}}
      ]
    }}
  ]
}
