{
  "type": "record",
  "name": "PlanoCreateEvent",
  "namespace": "com.vivo.dataai.tmfproductcatalog",
  "doc": "Entidade TM Forum: ProductOffering \u00b7 TMF620. Espelha exatamente a tabela ATEND_PROD.TB_PLANO (mesmos nomes e tipos de coluna, incluindo a grafia em maiusculas da origem Oracle), para uso via broker sem disrupcao de consumidores diretos da base. Contrato base v1.0.0.",
  "fields": [
    {"name": "eventId", "type": "string"},
    {"name": "eventType", "type": "string", "default": "PlanoCreateEvent"},
    {"name": "eventTime", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "domain", "type": "string", "default": "Commercial"},
    {"name": "event", "type": {
      "type": "record",
      "name": "Plano",
      "fields": [
        {"name": "CD_PLANO", "type": "string", "doc": "PK."},
        {"name": "DS_PLANO", "type": "string"},
        {"name": "TP_PLANO", "type": "string"},
        {"name": "VL_MENSAL", "type": {"type": "bytes", "logicalType": "decimal", "precision": 10, "scale": 2}},
        {"name": "DT_INI_VIG", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "DATE no Oracle (inclui hora), mapeado para timestamp-millis."},
        {"name": "DT_FIM_VIG", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null, "doc": "DATE no Oracle (inclui hora), mapeado para timestamp-millis."}
      ]
    }}
  ]
}
