{
  "type": "record",
  "name": "ProductCreateEvent",
  "namespace": "com.vivo.dataai.tmfproductinventory",
  "doc": "Entidade TM Forum: Product \u00b7 TMF637. Espelha exatamente a tabela ATEND_PROD.TB_ASSIN (mesmos nomes e tipos de coluna, incluindo a grafia em maiusculas da origem Oracle), para uso via broker sem disrupcao de consumidores diretos da base. Os chips (ATEND_PROD.TB_SIMCARD) sao publicados em contrato/topico proprio (SimCardCreateEvent), nao mais aninhados aqui. Contrato base v1.0.0.",
  "fields": [
    {"name": "eventId", "type": "string"},
    {"name": "eventType", "type": "string", "default": "ProductCreateEvent"},
    {"name": "eventTime", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "domain", "type": "string", "default": "Commercial"},
    {"name": "event", "type": {
      "type": "record",
      "name": "Product",
      "fields": [
        {"name": "CD_ASSIN", "type": "long", "doc": "PK. NUMBER(10,0) na origem, excede int32, mapeado para long."},
        {"name": "CD_CLI", "type": "string", "doc": "FK -> crm_legado.tb_cli.cd_cli."},
        {"name": "NR_CONTA", "type": ["null", "string"], "default": null, "doc": "FK -> crm_legado.tb_conta.nr_conta."},
        {"name": "NR_MSISDN", "type": "string"},
        {"name": "CD_PLANO", "type": "string", "doc": "FK -> TB_PLANO.CD_PLANO."},
        {"name": "CD_DDD", "type": "string"},
        {"name": "FL_PORTAB", "type": "string", "doc": "CHAR(1) na origem (nao e tipo booleano nativo)."},
        {"name": "DT_ATIV", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "DATE no Oracle (inclui hora), mapeado para timestamp-millis."},
        {"name": "DT_CANC", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null, "doc": "DATE no Oracle (inclui hora), mapeado para timestamp-millis."},
        {"name": "ST_ASSIN", "type": "string"},
        {"name": "CD_FILIAL_LEG", "type": ["null", "string"], "default": null},
        {"name": "NR_LOTE_MIGR", "type": ["null", "string"], "default": null},
        {"name": "DT_ATUALIZACAO", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "DATE no Oracle (inclui hora), mapeado para timestamp-millis."}
      ]
    }}
  ]
}
